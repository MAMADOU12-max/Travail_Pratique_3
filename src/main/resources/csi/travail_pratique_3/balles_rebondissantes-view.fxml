<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csi.travail_pratique_3.BallesController">

    <center>
        <Pane fx:id="zoneJeu" prefHeight="250.0" prefWidth="600" styleClass="zone-Balles" />
    </center>

    <!-- Boutons -->
    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
            <Button onAction="#ajouterTroisBalles" styleClass="bouton-style, ajout-balles" text="Ajouter 3 balles" /> <!-- onAction="#ajouterTroisBalles" -->
            <Button onAction="#ajouterUneBalle" styleClass="bouton-style, ajout-balle" text="Ajouter 1 balle" /> <!-- onAction="#ajouterUneBalle" -->
            <Button onAction="#retirerBalle" styleClass="bouton-style, retirer-balle" text="Retirer 1 balle" /> <!-- onAction="#retirerBalle" -->
        </HBox>
    </bottom>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <top>
      <Label text="Balles rebondissantes" textFill="#ffbc2b" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold Italic" size="20.0" />
         </font>
      </Label>
   </top>

</BorderPane>
