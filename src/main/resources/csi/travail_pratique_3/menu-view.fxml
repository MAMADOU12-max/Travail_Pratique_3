<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" prefHeight="185.0" prefWidth="117.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="csi.travail_pratique_3.MenuController">
    <left>
        <VBox prefHeight="200.0" prefWidth="141.0" spacing="15" styleClass="vbox-menu">
         <HBox prefHeight="30.0" prefWidth="200.0">
            <children>
               <ImageView fitHeight="20.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../assets/home.png" />
                  </image>
                  <HBox.margin>
                     <Insets right="5.0" top="2.0" />
                  </HBox.margin>
               </ImageView>
                  <Button text="Balles a rebondissements"  styleClass="bouton-menu, balles-menu" onAction="#allerBallesRebondissantes" />
            </children>
         </HBox>
         <HBox prefHeight="30.0" prefWidth="200.0">
            <children>
               <ImageView fitHeight="20.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../assets/cibles.jpg" />
                  </image>
                  <HBox.margin>
                     <Insets right="0.0" top="2.0" />
                  </HBox.margin>
               </ImageView>
               <Button text="Cibles a taper"  styleClass="bouton-menu, cibles-menu" onAction="#allerCiblesAtaper" />
            </children>
         </HBox>
         <HBox prefHeight="30.0" prefWidth="200.0">
            <children>
               <ImageView fitHeight="20.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../assets/regles.png" />
                  </image>
                  <HBox.margin>
                     <Insets right="5.0" top="2.0" />
                  </HBox.margin>
               </ImageView>
               <Button text="Régles" styleClass="bouton-menu, regles-menu"   onAction="#allerRegles" />
            </children>
         </HBox>
         <HBox prefHeight="30.0" prefWidth="200.0">
            <children>
               <ImageView fitHeight="20.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../assets/quitter.png" />
                  </image>
                  <HBox.margin>
                     <Insets right="5.0" top="2.0" />
                  </HBox.margin>
               </ImageView>
               <Button text="Quitter" onAction="#quitter" styleClass="bouton-menu, quitter-menu" />
            </children>
         </HBox>
        </VBox>
    </left>

</BorderPane>
